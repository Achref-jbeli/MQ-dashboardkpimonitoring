<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>8aaabe0b-b3b7-40ae-8eb6-3967fbd5cb78</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
