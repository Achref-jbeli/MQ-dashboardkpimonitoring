  <PackageReference Include="QRCoder" Version="1.8.0" />
  <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />

  <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.28" />
